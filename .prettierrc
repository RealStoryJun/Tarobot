{
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 80, "tabWidth": 2 } },
    { "files": ["*.yml", "*.yaml", "*.json"], "options": { "tabWidth": 2 } }
  ]
}
